# Copy this file to .env.public. The target is ignored by Git.
# Public hostname: https://finquery.dev (configured in Cloudflare, not Compose).
TRADE_DATA_HOST_PATH=D:/trade_data
TRADE_DATA_CURATED_HOST_PATH=D:/trade_data_curated

# The local validation endpoint remains loopback-only. Cloudflare reaches the
# gateway over the private Compose network.
PUBLIC_PREVIEW_PORT=8080

# Enables the public guest button. Guest queries are limited by the backend to
# five new questions per Asia/Shanghai calendar day and source identity.
ENABLE_GUEST=false

# Replace all three values before starting the public-preview profile.
# App passwords must be unique, non-default, and at least 16 characters.
FINQUERY_ADMIN_PASSWORD=
FINQUERY_MARKET_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=
