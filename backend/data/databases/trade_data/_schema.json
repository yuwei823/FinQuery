{
  "schema_version": "1.0.0",
  "database": "trade_data",
  "scenario": "中国股票日线行情、资金流、财务快照和行业分类",
  "role_tables": {"market_analyst": ["stock_daily"]},
  "tables": [
    {
      "id": "trade_data.stock_daily",
      "name": "stock_daily",
      "label": "股票日行情",
      "database": "trade_data",
      "domain": "股票行情",
      "description": "按股票和交易日记录的价格、成交、资金流、财务快照、指数成分和申万行业数据。",
      "business_terms": ["股票行情", "日线", "交易数据", "A股"],
      "profile_mode": "schema_only",
      "primary_key": ["symbol", "trade_date"],
      "fields": [
        {"name": "symbol", "label": "股票代码", "type": "文本", "source_type": "VARCHAR", "description": "包含交易所前缀的股票代码", "aliases": ["证券代码", "代码"], "role": "identifier", "aggregation": "none"},
        {"name": "stock_name", "label": "股票名称", "type": "文本", "source_type": "VARCHAR", "description": "股票在该交易日使用的简称", "aliases": ["证券名称", "名称"], "role": "entity_name", "aggregation": "none"},
        {"name": "trade_date", "label": "交易日期", "type": "日期", "source_type": "DATE", "description": "日行情所属交易日", "aliases": ["交易日", "日期"], "role": "time", "aggregation": "none"},
        {"name": "open", "label": "开盘价", "type": "数值", "source_type": "DOUBLE", "description": "当日开盘价格", "aliases": ["开盘价格"], "role": "metric", "aggregation": "avg"},
        {"name": "high", "label": "最高价", "type": "数值", "source_type": "DOUBLE", "description": "当日最高价格", "aliases": ["最高价格"], "role": "metric", "aggregation": "max"},
        {"name": "low", "label": "最低价", "type": "数值", "source_type": "DOUBLE", "description": "当日最低价格", "aliases": ["最低价格"], "role": "metric", "aggregation": "min"},
        {"name": "close", "label": "收盘价", "type": "数值", "source_type": "DOUBLE", "description": "当日收盘价格", "aliases": ["收盘价格"], "role": "metric", "aggregation": "avg"},
        {"name": "previous_close", "label": "前收盘价", "type": "数值", "source_type": "DOUBLE", "description": "前一交易日收盘价格", "aliases": ["昨收价", "前一日收盘价"], "role": "metric", "aggregation": "avg"},
        {"name": "volume", "label": "成交量", "type": "数值", "source_type": "DOUBLE", "description": "当日股票成交数量", "aliases": ["交易量"], "role": "metric", "aggregation": "sum"},
        {"name": "turnover", "label": "成交额", "type": "数值", "source_type": "DOUBLE", "description": "当日股票成交金额", "aliases": ["交易额"], "role": "metric", "aggregation": "sum"},
        {"name": "float_market_cap", "label": "流通市值", "type": "数值", "source_type": "DOUBLE", "description": "当日流通股份市值", "aliases": [], "role": "metric", "aggregation": "avg"},
        {"name": "total_market_cap", "label": "总市值", "type": "数值", "source_type": "DOUBLE", "description": "当日股票总市值", "aliases": ["市值"], "role": "metric", "aggregation": "avg"},
        {"name": "net_profit_ttm", "label": "净利润TTM", "type": "数值", "source_type": "DOUBLE", "description": "滚动十二个月净利润", "aliases": ["滚动净利润"], "role": "metric", "aggregation": "avg"},
        {"name": "cash_flow_ttm", "label": "现金流TTM", "type": "数值", "source_type": "DOUBLE", "description": "滚动十二个月现金流", "aliases": ["滚动现金流"], "role": "metric", "aggregation": "avg"},
        {"name": "net_assets", "label": "净资产", "type": "数值", "source_type": "DOUBLE", "description": "最新可用财务快照中的净资产", "aliases": [], "role": "metric", "aggregation": "avg"},
        {"name": "total_assets", "label": "总资产", "type": "数值", "source_type": "DOUBLE", "description": "最新可用财务快照中的总资产", "aliases": [], "role": "metric", "aggregation": "avg"},
        {"name": "total_liabilities", "label": "总负债", "type": "数值", "source_type": "DOUBLE", "description": "最新可用财务快照中的总负债", "aliases": [], "role": "metric", "aggregation": "avg"},
        {"name": "quarter_net_profit", "label": "当季净利润", "type": "数值", "source_type": "DOUBLE", "description": "最近单季度净利润", "aliases": ["净利润当季", "单季净利润"], "role": "metric", "aggregation": "avg"},
        {"name": "medium_buy_amount", "label": "中户资金买入额", "type": "数值", "source_type": "DOUBLE", "description": "中户资金买入金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "medium_sell_amount", "label": "中户资金卖出额", "type": "数值", "source_type": "DOUBLE", "description": "中户资金卖出金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "large_buy_amount", "label": "大户资金买入额", "type": "数值", "source_type": "DOUBLE", "description": "大户资金买入金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "large_sell_amount", "label": "大户资金卖出额", "type": "数值", "source_type": "DOUBLE", "description": "大户资金卖出金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "retail_buy_amount", "label": "散户资金买入额", "type": "数值", "source_type": "DOUBLE", "description": "散户资金买入金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "retail_sell_amount", "label": "散户资金卖出额", "type": "数值", "source_type": "DOUBLE", "description": "散户资金卖出金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "institution_buy_amount", "label": "机构资金买入额", "type": "数值", "source_type": "DOUBLE", "description": "机构资金买入金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "institution_sell_amount", "label": "机构资金卖出额", "type": "数值", "source_type": "DOUBLE", "description": "机构资金卖出金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "is_csi_300", "label": "沪深300成分股", "type": "布尔", "source_type": "BOOLEAN", "description": "是否属于沪深300指数", "aliases": ["沪深300", "CSI300"], "role": "dimension", "aggregation": "none"},
        {"name": "is_sse_50", "label": "上证50成分股", "type": "布尔", "source_type": "BOOLEAN", "description": "是否属于上证50指数", "aliases": ["上证50"], "role": "dimension", "aggregation": "none"},
        {"name": "is_csi_500", "label": "中证500成分股", "type": "布尔", "source_type": "BOOLEAN", "description": "是否属于中证500指数", "aliases": ["中证500", "CSI500"], "role": "dimension", "aggregation": "none"},
        {"name": "is_csi_1000", "label": "中证1000成分股", "type": "布尔", "source_type": "BOOLEAN", "description": "是否属于中证1000指数", "aliases": ["中证1000", "CSI1000"], "role": "dimension", "aggregation": "none"},
        {"name": "is_csi_2000", "label": "中证2000成分股", "type": "布尔", "source_type": "BOOLEAN", "description": "是否属于中证2000指数", "aliases": ["中证2000", "CSI2000"], "role": "dimension", "aggregation": "none"},
        {"name": "is_chinext", "label": "创业板指成分股", "type": "布尔", "source_type": "BOOLEAN", "description": "是否属于创业板指数", "aliases": ["创业板指", "创业板成分股"], "role": "dimension", "aggregation": "none"},
        {"name": "industry_level_1", "label": "申万一级行业", "type": "文本", "source_type": "VARCHAR", "description": "新版申万一级行业名称", "aliases": ["一级行业"], "role": "dimension", "aggregation": "none"},
        {"name": "industry_level_2", "label": "申万二级行业", "type": "文本", "source_type": "VARCHAR", "description": "新版申万二级行业名称", "aliases": ["二级行业"], "role": "dimension", "aggregation": "none"},
        {"name": "industry_level_3", "label": "申万三级行业", "type": "文本", "source_type": "VARCHAR", "description": "新版申万三级行业名称", "aliases": ["三级行业"], "role": "dimension", "aggregation": "none"},
        {"name": "close_0935", "label": "09:35收盘价", "type": "数值", "source_type": "DOUBLE", "description": "09:35时点价格", "aliases": ["九点三十五价格"], "role": "metric", "aggregation": "avg"},
        {"name": "close_0945", "label": "09:45收盘价", "type": "数值", "source_type": "DOUBLE", "description": "09:45时点价格", "aliases": ["九点四十五价格"], "role": "metric", "aggregation": "avg"},
        {"name": "close_0955", "label": "09:55收盘价", "type": "数值", "source_type": "DOUBLE", "description": "09:55时点价格", "aliases": ["九点五十五价格"], "role": "metric", "aggregation": "avg"}
      ]
    }
  ],
  "relations": []
}
