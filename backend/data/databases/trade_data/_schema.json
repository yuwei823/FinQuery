        {"name": "turnover", "label": "成交额", "type": "数值", "source_type": "DOUBLE", "description": "当日股票成交金额", "aliases": ["交易额"], "role": "metric", "aggregation": "sum"},
        {"name": "float_market_cap", "label": "流通市值", "type": "数值", "source_type": "DOUBLE", "description": "当日流通股份市值", "aliases": [], "role": "metric", "aggregation": "avg"},
        {"name": "total_market_cap", "label": "总市值", "type": "数值", "source_type": "DOUBLE", "description": "当日股票总市值", "aliases": ["市值"], "role": "metric", "aggregation": "avg"},
        {"name": "net_profit_ttm", "label": "净利润TTM", "type": "数值", "source_type": "DOUBLE", "description": "滚动十二个月净利润", "aliases": ["滚动净利润"], "role": "metric", "aggregation": "avg"},
