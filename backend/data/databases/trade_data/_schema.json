{
  "schema_version": "1.0.0",
  "database": "trade_data",
  "scenario": "中国股票和主要指数的日线行情、资金流、财务快照和行业分类",
  "role_tables": {"market_analyst": ["stock_daily", "index_daily", "financial_statement", "stock_etf_trading_data"]},
  "tables": [
    {
