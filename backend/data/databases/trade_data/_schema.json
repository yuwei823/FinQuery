        {"name": "net_assets", "label": "净资产", "type": "数值", "source_type": "DOUBLE", "description": "最新可用财务快照中的净资产", "aliases": [], "role": "metric", "aggregation": "avg"},
        {"name": "total_assets", "label": "总资产", "type": "数值", "source_type": "DOUBLE", "description": "最新可用财务快照中的总资产", "aliases": [], "role": "metric", "aggregation": "avg"},
        {"name": "total_liabilities", "label": "总负债", "type": "数值", "source_type": "DOUBLE", "description": "最新可用财务快照中的总负债", "aliases": [], "role": "metric", "aggregation": "avg"},
