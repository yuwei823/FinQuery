        {"name": "is_csi_1000", "label": "中证1000成分股", "type": "布尔", "source_type": "BOOLEAN", "description": "是否属于中证1000指数", "aliases": ["中证1000", "CSI1000"], "role": "dimension", "aggregation": "none"},
        {"name": "is_csi_2000", "label": "中证2000成分股", "type": "布尔", "source_type": "BOOLEAN", "description": "是否属于中证2000指数", "aliases": ["中证2000", "CSI2000"], "role": "dimension", "aggregation": "none"},
