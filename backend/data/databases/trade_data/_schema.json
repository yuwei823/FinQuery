        {"name": "financing_cash_flow", "label": "筹资活动现金流净额", "type": "数值", "source_type": "DOUBLE", "description": "筹资活动产生的现金流量净额", "aliases": ["筹资现金流"], "role": "metric", "aggregation": "sum"},
        {"name": "net_cash_increase", "label": "现金净增加额", "type": "数值", "source_type": "DOUBLE", "description": "现金及现金等价物净增加额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "ending_cash_balance", "label": "期末现金余额", "type": "数值", "source_type": "DOUBLE", "description": "期末现金及现金等价物余额", "aliases": [], "role": "metric", "aggregation": "sum"}
      ]
    },
    {
      "id": "trade_data.index_daily",
