        {"name": "large_buy_amount", "label": "大户资金买入额", "type": "数值", "source_type": "DOUBLE", "description": "大户资金买入金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "large_sell_amount", "label": "大户资金卖出额", "type": "数值", "source_type": "DOUBLE", "description": "大户资金卖出金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "retail_buy_amount", "label": "散户资金买入额", "type": "数值", "source_type": "DOUBLE", "description": "散户资金买入金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "retail_sell_amount", "label": "散户资金卖出额", "type": "数值", "source_type": "DOUBLE", "description": "散户资金卖出金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "institution_buy_amount", "label": "机构资金买入额", "type": "数值", "source_type": "DOUBLE", "description": "机构资金买入金额", "aliases": [], "role": "metric", "aggregation": "sum"},
        {"name": "institution_sell_amount", "label": "机构资金卖出额", "type": "数值", "source_type": "DOUBLE", "description": "机构资金卖出金额", "aliases": [], "role": "metric", "aggregation": "sum"},
